# Node.js (current LTS) for building, packaging and debugging the VS Code
# extension in editors/vscode. Taken from the official image, which is built
# on the same Debian release as the Rust image below.
FROM docker.io/library/node:26-trixie-slim AS node

FROM mcr.microsoft.com/devcontainers/rust:2.1.6-trixie

COPY --from=node /usr/local/bin/node /usr/local/bin/node
COPY --from=node /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -s ../lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -s ../lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# musl-tools: C compiler for the optional static musl build (the default
# build is static glibc and needs nothing extra; see .cargo/config.toml).
# python3-sphinx: builds the documentation in docs/ (`make -C docs html`).
# xvfb and the lib* packages: run VS Code headless for the extension's
# integration test (`xvfb-run -a npm test` in editors/vscode).
RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools python3-sphinx make \
        xvfb xauth libnss3 libgtk-3-0t64 libasound2t64 libgbm1 libxkbfile1 libsecret-1-0 \
    && rm -rf /var/lib/apt/lists/*

USER vscode
RUN rustup target add x86_64-unknown-linux-musl
USER root
